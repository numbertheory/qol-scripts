#!/usr/bin/env bash
# Description: Provide some functions for doing the math

math_floor() {
  math "$1 < 0 && $1 != int($1) ? int($1) - 1 : int($1)"
}

calc() {
  echo "$@" | bc -l
}

math() {
  awk "BEGIN { print $* }"
}

hex2dec() {
  echo $((16#$1))
}

math_ceil() {
  math "$1 > 0 && $1 != int($1) ? int($1) + 1 : int($1)"
}

math_abs() {
  math "$1 < 0 ? -$1 : $1"
}

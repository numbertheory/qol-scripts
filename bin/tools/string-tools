#!/usr/bin/env bash

# Description: Common string tools for Quality of Life scripts.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
source $SCRIPT_DIR/../tools/qol-preamble --colors

section_header() {
    echo -e "\n${BOLD}${CYAN}→${RESET} ${BOLD}$1${RESET}"
}

# Helper function for key-value pairs
print_kv() {
    echo -e $3 "${BLUE}$(printf '%-20.20s' "$1")${RESET} ${2}${RESET}"
}

unzip_to_json () {
    unzip -Z1 $1 | python3 -c '
    import sys, json

    def add_path(tree, path):
        parts = path.strip().split("/")
        for part in parts:
            if not part: continue
            tree = tree.setdefault(part, {})

    tree = {}
    for line in sys.stdin:
        add_path(tree, line)

    print(json.dumps(tree, indent=4))
    '
}

json_to_tree () {
    jq -r '
      def draw_tree(prefix):
        to_entries | . as $entries |
        range(length) | . as $i |
        $entries[$i] |
        (.key) as $name |
        ($i == ($entries | length - 1)) as $is_last |

        # Determine the branch symbol
        (if $is_last then "└── " else "├── " end) as $branch |

        # Print the current line
        (prefix + $branch + $name),

        # If the value is a non-empty object, recurse
        ($entries[$i].value | if type == "object" and length > 0
          then draw_tree(prefix + (if $is_last then "    " else "│   " end))
          else empty end);

      draw_tree("")
    '
}

tolower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
toupper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

print_kv_comments() {
    echo -e "${BLUE}$(printf '%-20.20s' "$1")${RESET} ${2}${RESET}\t${LIGHT_GRAY}# ${3}${RESET}"
}

text_file_stats() {
    WC_OUTPUT=$(wc -l -w -c "$FILENAME")
    TEXT_FILE_LINES=$(echo "$WC_OUTPUT" | awk '{print $1}')
    TEXT_FILE_WORDS=$(echo "$WC_OUTPUT" | awk '{print $2}')
    TEXT_FILE_CHARS=$(echo "$WC_OUTPUT" | awk '{print $3}')
    TEXT_FILE_ENCODING=$(file -b --mime-encoding "$FILENAME" 2>/dev/null)
    print_kv "Lines" "$TEXT_FILE_LINES"
    print_kv "Words" "$TEXT_FILE_WORDS"
    print_kv "Characters" "$TEXT_FILE_CHARS"
    print_kv "Encoding" "$TEXT_FILE_ENCODING"
}

# Helper function to format the 'rwx' triplets
parse_bit() {
    [[ $1 == "$2" ]] && echo "  ●  " || echo "  ○  "
}

permissions_calc() {
    PERMS=$(ls -ld "$1" | awk '{print $1}')
    # Get the numeric version (OS-agnostic check)
    if [[ $(uname -s) == "Darwin" ]]; then
        NUMERIC_PERMS=$(stat -f "%Lp" "$1")
    else
        NUMERIC_PERMS=$(stat -c "%a" "$1")
    fi

    # Extract triplets
    U_R=$(parse_bit "${PERMS:1:1}" "r")
    U_W=$(parse_bit "${PERMS:2:1}" "w")
    U_X=$(parse_bit "${PERMS:3:1}" "x")

    G_R=$(parse_bit "${PERMS:4:1}" "r")
    G_W=$(parse_bit "${PERMS:5:1}" "w")
    G_X=$(parse_bit "${PERMS:6:1}" "x")

    O_R=$(parse_bit "${PERMS:7:1}" "r")
    O_W=$(parse_bit "${PERMS:8:1}" "w")
    O_X=$(parse_bit "${PERMS:9:1}" "x")

    print_kv "Permissions ($NUMERIC_PERMS)" "" "-n"
    # Get the numeric version (OS-agnostic check)
    if [[ $(uname -s) == "Darwin" ]]; then
        EXTRA_SPACE=""
    else
        EXTRA_SPACE="  "
    fi
    echo -e "${EXTRA_SPACE}┏━━━━━━━━┳━━━━━━━┳━━━━━━━┳━━━━━━━━━┓"
    echo -e "\t\t  ${EXTRA_SPACE}   ┃ Entity ┃ Read  ┃ Write ┃ Execute ┃"
    echo -e "\t\t  ${EXTRA_SPACE}   ┣━━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━━━┫"
    printf "\t\t   %s  ┃ Owner  ┃%s  ┃%s  ┃%s    ┃\n" "$EXTRA_SPACE" "$U_R" "$U_W" "$U_X"
    echo -e "\t\t  ${EXTRA_SPACE}   ┣━━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━━━┫"
    printf "\t\t   %s  ┃ Group  ┃%s  ┃%s  ┃%s    ┃\n" "$EXTRA_SPACE" "$G_R" "$G_W" "$G_X"
    echo -e "\t\t  ${EXTRA_SPACE}   ┣━━━━━━━━╋━━━━━━━╋━━━━━━━╋━━━━━━━━━┫"
    printf "\t\t   %s  ┃ Others ┃%s  ┃%s  ┃%s    ┃\n" "$EXTRA_SPACE" "$O_R" "$O_W" "$O_X"
    echo -e "\t\t  ${EXTRA_SPACE}   ┗━━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━━━┛"
}
